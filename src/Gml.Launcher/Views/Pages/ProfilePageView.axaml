<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Gml.Launcher.ViewModels.Pages"
             xmlns:lang="clr-namespace:Gml.Launcher.Assets.Resources"
             xmlns:components="clr-namespace:Gml.Launcher.Views.Components"
             xmlns:converters="clr-namespace:Gml.Launcher.Core.Converters"
             xmlns:avalonia="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             mc:Ignorable="d"
             d:DesignWidth="1000"
             d:DesignHeight="600"
             x:DataType="vm:ProfilePageViewModel"
             x:Class="Gml.Launcher.Views.Pages.ProfilePageView">

    <Grid>
        <Border Padding="20">
            <Grid ColumnDefinitions="350, 30, *" RowDefinitions="Auto, 30, *">

                <!-- Navigation -->
                <Grid Grid.ColumnSpan="3" Grid.Row="0">
                    <components:GmlButton Classes="TextIcon Additional"
                                          Padding="15, 0, 20 ,0"
                                          IconPath="/Assets/Images/back.svg"
                                          IconSize="22"
                                          Text="{x:Static lang:Resources.Back}"
                                          Command="{Binding GoBackCommand}" />
                </Grid>

                <components:ProfileUserControl Grid.Row="2"
                                               Grid.Column="0"
                                               UserName="{Binding LauncherUser.Name}"
                                               SkinUrl="{Binding TextureUrl, Converter={converters:NoiseStringAddConverter}}"
                                               VerticalAlignment="Top">

                    <components:ProfileInfoComponent ProfileInfoItems="{Binding ProfileInfoItems}" />

                    <components:GmlButton Classes="TextIcon Primary"
                                          Margin="0, 15, 0, 0"
                                          Padding="15, 10, 10, 10"
                                          Command="{Binding OpenLinkCommand}"
                                          CommandParameter="{Binding CabinetUrl}"
                                          IsVisible="{Binding CabinetUrl, Converter={x:Static avalonia:StringConverters.IsNotNullOrEmpty}}"
                                          IconSize="20"
                                          IconPath="/Assets/Images/home.svg"
                                          Text="{x:Static lang:Resources.Cabinet}"
                                          HorizontalAlignment="Center" />
                </components:ProfileUserControl>

                <components:StackFrameBorder Grid.Row="2"
                                             Grid.Column="2"
                                             Spacing="20"
                                             VerticalAlignment="Stretch">
                    <TextBlock Text="{x:Static lang:Resources.Statistics}"
                               Classes="HeadlineText"
                               Foreground="{DynamicResource PrimaryColor}"
                               HorizontalAlignment="Center"
                               FontSize="28"
                               FontWeight="ExtraBlack"
                               Margin="0, 0, 0, 10" />

                    <components:LoadingControl IsVisible="{Binding IsCabinetLoading}"
                                               Background="Transparent"
                                               Foreground="{DynamicResource PrimaryColor}"
                                               Size="40"
                                               HorizontalAlignment="Center" />

                    <TextBlock IsVisible="{Binding CabinetMessage, Converter={x:Static avalonia:StringConverters.IsNotNullOrEmpty}}"
                               Text="{Binding CabinetMessage}"
                               Classes="FormText"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               Opacity="0.8" />

                    <Grid IsVisible="{Binding HasServerStats}"
                          ColumnDefinitions="*, *, *"
                          Margin="0, 10, 0, 5">
                        <TextBlock Text="{x:Static lang:Resources.ServerColumn}"
                                   Foreground="{DynamicResource PrimaryColor}"
                                   FontWeight="Bold"
                                   FontSize="16" />
                        <TextBlock Grid.Column="1"
                                   Text="{x:Static lang:Resources.DonateGroupColumn}"
                                   Foreground="{DynamicResource PrimaryColor}"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="2"
                                   Text="{x:Static lang:Resources.PlayedColumn}"
                                   Foreground="{DynamicResource PrimaryColor}"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   HorizontalAlignment="Right" />
                    </Grid>

                    <ScrollViewer IsVisible="{Binding HasServerStats}"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ServerStats}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProfileServerStatItem">
                                    <Grid ColumnDefinitions="*, *, *"
                                          Margin="0, 10">
                                        <TextBlock Text="{Binding ServerName}"
                                                   Foreground="{DynamicResource PrimaryColor}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding ServerName}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding DonateGroup}"
                                                   Foreground="{DynamicResource PrimaryColor}"
                                                   HorizontalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding DonateGroup}" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Playtime}"
                                                   Foreground="{DynamicResource PrimaryColor}"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock IsVisible="{Binding ShowStatsPlaceholder}"
                               Text="{x:Static lang:Resources.ProfileStatsEmpty}"
                               Classes="FormText"
                               HorizontalAlignment="Center"
                               Opacity="0.7" />
                </components:StackFrameBorder>

            </Grid>
        </Border>
    </Grid>

</UserControl>
